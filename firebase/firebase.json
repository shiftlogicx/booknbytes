{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/downloads/BookNBite_Hotel.apk",
        "destination": "https://github.com/shiftlogicx/booknbytes/releases/latest/download/BookNBite_Hotel.apk",
        "type": 302
      },
      {
        "source": "/download",
        "destination": "https://github.com/shiftlogicx/booknbytes/releases/latest/download/BookNBite_Hotel.apk",
        "type": 302
      }
    ]
  }
}
